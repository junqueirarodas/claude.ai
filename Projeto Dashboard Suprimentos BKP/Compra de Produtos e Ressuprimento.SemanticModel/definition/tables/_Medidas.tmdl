table _Medidas
	lineageTag: a771b61c-f0e2-48e6-a675-05753ae93841

	/// Lead time médio (dias) entre abertura e aprovação da solicitação de compra = soma dos valores preenchidos dividida pela quantidade de valores preenchidos. SUM() e COUNT() ignoram NULL/BLANK nativamente, logo linhas sem essa etapa não entram no cálculo.
	measure 'Abertura até Aprovação' =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaberturasolicitacaoaprovacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaberturasolicitacaoaprovacao] )
			)
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: 965adb54-f5e7-41d8-aa8e-4a3c730b9c11

	/// Lead time médio (dias) entre aprovação da solicitação e emissão da cotação = soma dos valores preenchidos dividida pela quantidade de valores preenchidos. SUM() e COUNT() ignoram NULL/BLANK nativamente, logo linhas sem essa etapa não entram no cálculo.
	measure 'Aprovação até Cotação' =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaprovacaosolicitacaocotacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaprovacaosolicitacaocotacao] )
			)
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: 8d5cdf97-e646-4d0a-871a-e586466c0898

	/// Lead time médio (dias) entre a cotação e a emissão da ordem de compra = soma dos valores preenchidos dividida pela quantidade de valores preenchidos. SUM() e COUNT() ignoram NULL/BLANK nativamente, logo linhas sem essa etapa não entram no cálculo.
	measure 'Cotação até Ordem Compra' =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimecotacaocompra] ),
			    COUNT ( fat_compraproduto[vl_leadtimecotacaocompra] )
			)
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: ef4593a3-61a4-4fc8-b718-84b78e19cd36

	/// Lead time médio (dias) entre a emissão e a aprovação da ordem de compra = soma dos valores preenchidos dividida pela quantidade de valores preenchidos. SUM() e COUNT() ignoram NULL/BLANK nativamente, logo linhas sem essa etapa não entram no cálculo.
	measure 'Ordem Compra até Aprovação' =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimecompraaprovacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimecompraaprovacao] )
			)
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: 8f517119-a8d5-4888-b29c-0c83044d021a

	/// Lead time médio (dias) entre a aprovação da ordem de compra e o recebimento = soma dos valores preenchidos dividida pela quantidade de valores preenchidos. SUM() e COUNT() ignoram NULL/BLANK nativamente, logo linhas sem essa etapa não entram no cálculo.
	measure 'Aprovação até Recebimento' =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaprovacaorecebimento] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaprovacaorecebimento] )
			)
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: c011b4ac-3c44-45da-a412-9d5151b56ce4

	/// Lead time médio geral (dias) = soma de todos os valores preenchidos nos 5 lead times de etapa, dividida pela quantidade de valores preenchidos (não pela quantidade de linhas). SUM() e COUNT() ignoram nativamente NULL/BLANK, logo etapas não preenchidas não entram nem no numerador nem no denominador do cálculo.
	measure 'Lead Time Geral' = ```
			VAR LTSolicitacaoAprovacao =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaberturasolicitacaoaprovacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaberturasolicitacaoaprovacao] )
			)
			VAR LTAprovacaoSolicitacaoCotacao =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaprovacaosolicitacaocotacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaprovacaosolicitacaocotacao] )
			) 
			VAR LTCotacaoCompra =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimecotacaocompra] ),
			    COUNT ( fat_compraproduto[vl_leadtimecotacaocompra] )
			)
			VAR LTCompraAprovacaoOrdem =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimecompraaprovacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimecompraaprovacao] )
			)
			VAR LTAprovacaoOrdemRecebimento =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaprovacaorecebimento] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaprovacaorecebimento] )
			)
			VAR LTGeral = ( LTSolicitacaoAprovacao + LTAprovacaoSolicitacaoCotacao + LTCotacaoCompra + LTCompraAprovacaoOrdem + LTAprovacaoOrdemRecebimento )
			RETURN LTGeral
			```
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: f18b96f2-05b8-4ba5-a4b8-adc84fe6ff49

	/// Medida de suporte: quantidade de linhas de fat_compraproduto no contexto de filtro atual. Usada para restringir slicers (ex.: Safra) a exibir apenas valores de dimensão que possuem correspondência real via relacionamento sk_safra, evitando itens sem dados.
	measure 'Qtd Registros (Fato)' = COUNTROWS ( fat_compraproduto )
		formatString: 0
		isHidden
		displayFolder: Suporte
		lineageTag: 0516aed6-7016-41c7-97f6-b9ad35790476

	/// Medida de suporte: posição (ranking) do fornecedor pelo lead time médio de Aprovação até Recebimento (atraso na entrega da mercadoria), do maior para o menor. Usada para filtrar o gráfico 'TOP Fornecedores (atraso entrega da mercadoria)' aos 20 fornecedores com maior lead time.
	measure 'Rank Fornecedor (Atraso Entrega)' = RANKX ( ALLSELECTED ( dim_fornecedor[ds_fornecedor] ), [Aprovação até Recebimento], , DESC, DENSE )
		formatString: 0
		isHidden
		displayFolder: Suporte
		lineageTag: f89e4962-51c7-463d-b1ec-a33303b852e2

	/// Quantidade total de solicitações de compra pendentes de aprovação, com base em fat_compraproduto[ds_statussolicitacaofluig] = "Pendente". O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Produtos de Solicitação Pendentes de Aprovação' =
			CALCULATE (
			    COUNTROWS ( fat_compraproduto ),
			    fat_compraproduto[ds_statussolicitacaofluig] = "Pendente"
			) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: ebf6cdcf-8a3a-4247-a3f2-458ce2e55af7

	/// Quantidade de solicitações de compra distintas pendentes de aprovação, contando cada solicitação (nr_processosolicitacaofluig) uma única vez mesmo quando possui vários itens/produtos (linhas) em fat_compraproduto. Base: fat_compraproduto[ds_statussolicitacaofluig] = "Pendente". O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Solicitações Pendentes de Aprovação (NR Solicitação)' =
			CALCULATE (
			    DISTINCTCOUNT ( fat_compraproduto[nr_processosolicitacaofluig] ),
			    fat_compraproduto[ds_statussolicitacaofluig] = "Pendente"
			) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: bc15f89c-331f-447b-8516-eb200813c39d

	/// Quantidade de solicitações de compra distintas (nr_processosolicitacaofluig) pendentes de aprovação (ds_statussolicitacaofluig = "Pendente") cuja abertura (dt_aberturasolicitacaofluig + hr_aberturasolicitacaofluig) já ultrapassou 24 horas em relação ao momento atual (NOW()). O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Solicitações Pendentes de Aprovação (Atraso 48h)' =
			VAR LimiteAtraso =
			    NOW () - 2
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( fat_compraproduto[nr_processosolicitacaofluig] ),
			        FILTER (
			            fat_compraproduto,
			            fat_compraproduto[ds_statussolicitacaofluig] = "Pendente"
			                && fat_compraproduto[dt_aberturasolicitacaofluig] + TIMEVALUE ( fat_compraproduto[hr_aberturasolicitacaofluig] ) <= LimiteAtraso
			        )
			    ) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: d49f6492-236a-4d23-ba7e-b9181d7e27c8

	/// Data e hora de abertura da solicitação em um único valor (dt_aberturasolicitacaofluig + hr_aberturasolicitacaofluig), para exibir como coluna única "Abertura Fluig" na tabela de análise, substituindo as colunas separadas de data e horário.
	measure 'Data e Horário Abertura Fluig' =
			VAR DataAbertura = SELECTEDVALUE ( fat_compraproduto[dt_aberturasolicitacaofluig] )
			VAR HoraAbertura = SELECTEDVALUE ( fat_compraproduto[hr_aberturasolicitacaofluig] )
			RETURN
			    IF (
			        NOT ISBLANK ( DataAbertura ) && NOT ISBLANK ( HoraAbertura ),
			        DataAbertura + TIMEVALUE ( HoraAbertura )
			    )
		formatString: dd/mm/yyyy hh:mm
		displayFolder: Data
		lineageTag: 6e3456fb-5504-491e-afba-bd665c6e2fcb

	/// Prazo decorrido, em horas, desde a abertura da solicitação (dt_aberturasolicitacaofluig + hr_aberturasolicitacaofluig) até o momento atual (NOW()). Usada como coluna "Prazo" na tabela de análise de solicitações pendentes; valores sensíveis ao momento da atualização/consulta.
	measure 'Prazo Solicitação Compras (Horas)' =
			VAR _Abertura = [Data e Horário Abertura Fluig]
			RETURN
			    IF (
			        NOT ISBLANK ( _Abertura ),
			        ROUND ( ( NOW () - _Abertura ) * 24, 1 )
			    )
		formatString: 0.0 "h"
		displayFolder: KPIs
		lineageTag: abab18fd-ab23-4bfa-a8fd-2b8a54a8d73f

	/// Quantidade de solicitações distintas (nr_identificadorsolicitacaoerp) pendentes de envio de cotação: fat_compraproduto[ds_statussolicitacaoerp] = "Pendente" e fat_compraproduto[nr_cotacao] em branco/nulo. O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Solicitações Pendentes de Cotação' =
			CALCULATE (
			    DISTINCTCOUNT ( fat_compraproduto[nr_identificadorsolicitacaoerp] ),
			    fat_compraproduto[ds_statussolicitacaoerp] = "Pendente",
			    ISBLANK ( fat_compraproduto[nr_cotacao] )
			) + 0
		displayFolder: KPIs
		lineageTag: 9efeefe3-0d51-4d53-9cf0-c3925d3aae1e

	/// Quantidade de produtos (linhas de fat_compraproduto) pendentes de envio de cotação: fat_compraproduto[ds_statussolicitacaoerp] = "Pendente" e fat_compraproduto[nr_cotacao] em branco/nulo. O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Produtos Pendentes de Cotação' =
			CALCULATE (
			    COUNTROWS ( fat_compraproduto ),
			    fat_compraproduto[ds_statussolicitacaoerp] = "Pendente",
			    ISBLANK ( fat_compraproduto[nr_cotacao] )
			) + 0
		displayFolder: KPIs
		lineageTag: 6ef34ebc-7a6b-4c24-b05d-06b91851e71f

	/// Quantidade de solicitações distintas (nr_identificadorsolicitacaoerp) pendentes de envio de cotação (ds_statussolicitacaoerp = "Pendente" e nr_cotacao em branco/nulo) cujo prazo, contado a partir de dt_aprovacaosolicitacao + hr_aprovacaosolicitacao, já ultrapassou 24 horas em relação a NOW(). Campo hr_aprovacaocotacao solicitado não existe em fat_compraproduto; substituído por hr_aprovacaosolicitacao (par correto de dt_aprovacaosolicitacao). O "+ 0" garante retorno 0 em vez de BLANK.
	measure 'Qtd Solicitações Pendentes de Cotação (Atraso 24h)' =
			VAR LimiteAtraso = NOW () - 1
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( fat_compraproduto[nr_identificadorsolicitacaoerp] ),
			        FILTER (
			            fat_compraproduto,
			            fat_compraproduto[ds_statussolicitacaoerp] = "Pendente"
			                && ISBLANK ( fat_compraproduto[nr_cotacao] )
			                && NOT ISBLANK ( fat_compraproduto[dt_aprovacaosolicitacao] )
			                && NOT ISBLANK ( fat_compraproduto[hr_aprovacaosolicitacao] )
			                && fat_compraproduto[dt_aprovacaosolicitacao] + TIMEVALUE ( fat_compraproduto[hr_aprovacaosolicitacao] ) <= LimiteAtraso
			        )
			    ) + 0
		displayFolder: KPIs
		lineageTag: e4234efc-64df-4305-a264-7a68246670b5

	/// Data e hora de aprovação da solicitação em um único valor (dt_aprovacaosolicitacao + hr_aprovacaosolicitacao), para exibir como coluna única "Aprovação Fluig" na tabela, substituindo as colunas separadas de data e horário.
	measure 'Data e Horário Aprovação Solicitação Fluig' = VAR DataAprovacao = SELECTEDVALUE(fat_compraproduto[dt_aprovacaosolicitacao]) VAR HoraAprovacao = SELECTEDVALUE(fat_compraproduto[hr_aprovacaosolicitacao]) RETURN IF(NOT ISBLANK(DataAprovacao) && NOT ISBLANK(HoraAprovacao), DataAprovacao + TIMEVALUE(HoraAprovacao))
		formatString: dd/mm/yyyy hh:mm
		displayFolder: Data
		lineageTag: 6652b25a-4af0-4c5f-a7b4-e2d1711033fe

	/// Prazo decorrido, em horas, desde a aprovação da solicitação (dt_aprovacaosolicitacao + hr_aprovacaosolicitacao) até o momento atual (NOW()). Usar como coluna "Prazo" na tabela (renomear título do campo no visual).
	measure 'Prazo Cotação (Horas)' = VAR DataAprovacao = SELECTEDVALUE(fat_compraproduto[dt_aprovacaosolicitacao]) VAR HoraAprovacao = SELECTEDVALUE(fat_compraproduto[hr_aprovacaosolicitacao]) VAR Aprovacao = DataAprovacao + TIMEVALUE(HoraAprovacao) RETURN IF(NOT ISBLANK(Aprovacao), ROUND((NOW()-Aprovacao)*24, 1))
		formatString: 0.0 "h"
		displayFolder: KPIs
		lineageTag: ccd452eb-d57e-47a7-bfc9-540d3498a77e

	/// Quantidade de cotações distintas (nr_cotacao) pendentes de envio ao fornecedor: fat_compraproduto[ds_statuscotacao] = "Composição" e fat_compraproduto[nr_cotacao] não em branco/nulo. O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Cotações Pendentes de Envio ao Fornecedor' = CALCULATE(DISTINCTCOUNT(fat_compraproduto[nr_cotacao]), fat_compraproduto[ds_statuscotacao] = "Composição", NOT ISBLANK(fat_compraproduto[nr_cotacao])) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: cb85e01c-ad18-4e34-829b-c51af39245d6

	/// Quantidade de cotações distintas (nr_cotacao) aguardando resposta do fornecedor: fat_compraproduto[ds_statuscotacao] = "Aguardando Resposta Fornecedores" (valor exato encontrado na coluna; texto solicitado "Aguardando resposta do fornecedor" não existia) e fat_compraproduto[nr_cotacao] não em branco/nulo. O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Cotações Aguardando Resposta do Fornecedor' = CALCULATE(DISTINCTCOUNT(fat_compraproduto[nr_cotacao]), fat_compraproduto[ds_statuscotacao] = "Aguardando Resposta Fornecedores", NOT ISBLANK(fat_compraproduto[nr_cotacao])) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 285953d9-4e2a-4b8b-a106-73ec6e723025

	/// Quantidade de cotações distintas (nr_cotacao) aguardando negociação: fat_compraproduto[ds_statuscotacao] igual a "Ordem de Compra Parcialmente Gerada", "Quadro Comparativo", "Negociação da Melhor Oferta", "Liberada" ou "Aguardando Análise da Cotação", e fat_compraproduto[nr_cotacao] não em branco/nulo. ATENÇÃO: dos 5 status, somente "Negociação da Melhor Oferta" existe atualmente na coluna ds_statuscotacao (valores reais: Não Cotado, Pedido de Compra, Concluída, Aguardando Resposta Fornecedores, Negociação da Melhor Oferta, Composição); os outros 4 não batem com nenhum valor existente e contribuem 0 até que passem a existir. O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Cotações Aguardando Negociação' = CALCULATE(DISTINCTCOUNT(fat_compraproduto[nr_cotacao]), fat_compraproduto[ds_statuscotacao] IN {"Ordem de Compra Parcialmente Gerada", "Quadro Comparativo", "Negociação da Melhor Oferta", "Liberada", "Aguardando Análise da Cotação"}, NOT ISBLANK(fat_compraproduto[nr_cotacao])) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: e38b6e5e-8d29-494f-957c-f0fe71f8cbf2

	/// Quantidade de produtos (linhas de fat_compraproduto, sem distíncía) pendentes de negociação: fat_compraproduto[ds_statuscotacao] igual a "Ordem de Compra Parcialmente Gerada", "Quadro Comparativo", "Negociação da Melhor Oferta", "Liberada" ou "Aguardando Análise da Cotação", e fat_compraproduto[nr_cotacao] não em branco/nulo. Similar a 'Qtd Cotações Aguardando Negociação', porém contando linhas (COUNTROWS) em vez de cotações distintas (DISTINCTCOUNT). ATENÇÃO: dos 5 status, somente "Negociação da Melhor Oferta" existe atualmente na coluna ds_statuscotacao; os outros 4 contribuem 0 até que passem a existir. O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Produtos Pendentes de Negociação' = CALCULATE(COUNTROWS(fat_compraproduto), fat_compraproduto[ds_statuscotacao] IN {"Ordem de Compra Parcialmente Gerada", "Quadro Comparativo", "Negociação da Melhor Oferta", "Liberada", "Aguardando Análise da Cotação"}, NOT ISBLANK(fat_compraproduto[nr_cotacao])) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: d718ea2e-e392-49c3-a786-87dcdd94eb14

	/// Quantidade de cotações distintas (nr_cotacao) pendentes de negociação com mais de 48 horas: fat_compraproduto[ds_statuscotacao] igual a "Aguardando Resposta Fornecedores", "Ordem de Compra Parcialmente Gerada", "Quadro Comparativo", "Negociação da Melhor Oferta", "Liberada" ou "Aguardando Análise da Cotação"; nr_cotacao não em branco/nulo (ajustado por confirmação do usuário: pedido original dizia 'igual a branco/nulo', o que tornaria DISTINCTCOUNT(nr_cotacao) sempre 0 ou 1); prazo contado a partir de dt_emissaocotacao + hr_emissaocotacao, mais de 48h em relação a NOW(). ATENÇÃO: dos 6 status, apenas "Aguardando Resposta Fornecedores" e "Negociação da Melhor Oferta" existem atualmente em ds_statuscotacao; os demais contribuem 0 até que passem a existir. O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Cotações Pendentes de Negociação (Atraso 48h)' =
			VAR LimiteAtraso = NOW() - 2
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(fat_compraproduto[nr_cotacao]),
			    FILTER(
			        fat_compraproduto,
			        fat_compraproduto[ds_statuscotacao] IN {"Aguardando Resposta Fornecedores", "Ordem de Compra Parcialmente Gerada", "Quadro Comparativo", "Negociação da Melhor Oferta", "Liberada", "Aguardando Análise da Cotação"}
			            && NOT ISBLANK(fat_compraproduto[nr_cotacao])
			            && NOT ISBLANK(fat_compraproduto[dt_emissaocotacao])
			            && NOT ISBLANK(fat_compraproduto[hr_emissaocotacao])
			            && fat_compraproduto[dt_emissaocotacao] + TIMEVALUE(fat_compraproduto[hr_emissaocotacao]) <= LimiteAtraso
			    )
			) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 7b28ad19-74ec-4e38-b392-985b12845268

	/// Retorna a menor data e hora de emissão da cotação (dt_emissaocotacao + hr_emissaocotacao) entre as linhas no contexto atual.
	measure 'Data e Horário Emissão Cotação' =
			MINX(
			    FILTER(
			        fat_compraproduto,
			        NOT ISBLANK(fat_compraproduto[dt_emissaocotacao]) && NOT ISBLANK(fat_compraproduto[hr_emissaocotacao])
			    ),
			    fat_compraproduto[dt_emissaocotacao] + TIMEVALUE(fat_compraproduto[hr_emissaocotacao])
			)
		formatString: dd/mm/yyyy hh:mm
		displayFolder: Data
		lineageTag: da3d8926-5c67-4262-8ad2-3561395d285b

	/// Prazo decorrido, em horas, desde a menor data e hora de emissão da cotação (menor valor combinado de dt_emissaocotacao + hr_emissaocotacao no contexto atual) até o momento atual (NOW()).
	measure 'Prazo Negociação (Horas)' =
			VAR _MenorEmissao =
			    MINX(
			        FILTER(
			            fat_compraproduto,
			            NOT ISBLANK(fat_compraproduto[dt_emissaocotacao]) && NOT ISBLANK(fat_compraproduto[hr_emissaocotacao])
			        ),
			        fat_compraproduto[dt_emissaocotacao] + TIMEVALUE(fat_compraproduto[hr_emissaocotacao])
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _MenorEmissao ),
			        ROUND ( ( NOW () - _MenorEmissao ) * 24, 1 )
			    )
		formatString: 0.0 "h"
		displayFolder: KPIs
		lineageTag: 385ad681-6ce7-448c-a4af-1361a2dfd1f9

	/// Quantidade de ordens de compra distintas (nr_identificadorordemcompra) aguardando aprovação: fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovação em andamento" e fat_compraproduto[nr_identificadorordemcompra] não em branco/nulo. O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Ordens de Compra Aguardando Aprovação' = CALCULATE(DISTINCTCOUNT(fat_compraproduto[nr_identificadorordemcompra]), fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovação em andamento", NOT ISBLANK(fat_compraproduto[nr_identificadorordemcompra])) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: b64a3bab-3e8c-4174-a70c-6092a994801d

	/// Quantidade de produtos (linhas de fat_compraproduto, sem distíncía) de ordens de compra aguardando aprovação: fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovação em andamento" e fat_compraproduto[nr_identificadorordemcompra] não em branco/nulo. Similar a 'Qtd Ordens de Compra Aguardando Aprovação', porém contando linhas (COUNTROWS) em vez de ordens distintas (DISTINCTCOUNT). O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Produtos de Ordem de Compra Aguardando Aprovação' = CALCULATE(COUNTROWS(fat_compraproduto), fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovação em andamento", NOT ISBLANK(fat_compraproduto[nr_identificadorordemcompra])) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 737a32e6-d63b-474e-95da-fbf994c2d90f

	/// Quantidade de produtos (linhas de fat_compraproduto, sem distíncía) de ordens de compra aguardando aprovação com cotações insuficientes: fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovação em andamento", fat_compraproduto[nr_identificadorordemcompra] não em branco/nulo, e fat_compraproduto[ds_statusrespostacotacao] igual a "[Não Urgente] Cotações insuficientes" ou "[Urgente] Cotações insuficientes" (valores exatos da coluna). Similar a 'Qtd Produtos de Ordem de Compra Aguardando Aprovação', com filtro adicional de cotações insuficientes. O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Produtos Aguardando Aprovação com Cotações Insuficientes' = CALCULATE(COUNTROWS(fat_compraproduto), fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovação em andamento", NOT ISBLANK(fat_compraproduto[nr_identificadorordemcompra]), fat_compraproduto[ds_statusrespostacotacao] IN {"[Não Urgente] Cotações insuficientes", "[Urgente] Cotações insuficientes"}) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 08bea9dd-ff9c-42db-b0c8-f2dcc7310337

	/// Quantidade de produtos (linhas de fat_compraproduto, sem distinção) de ordens de compra aguardando aprovação com variação de preço acima de 15%: fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovação em andamento", fat_compraproduto[nr_identificadorordemcompra] não em branco/nulo. Regra de variação: se vl_precomedioultimacompra > 0, usa vl_percmediovariacaoultimacompra > 0.15; se vl_precomedioultimacompra = 0, usa vl_percvariacaoultimacompra > 0.15 (ambos campos armazenados como fração decimal, onde 0.15 = 15%). O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Produtos Aguardando Aprovação com Variação Preço 15%' = CALCULATE(COUNTROWS(fat_compraproduto), fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovação em andamento", NOT ISBLANK(fat_compraproduto[nr_identificadorordemcompra]), IF(fat_compraproduto[vl_precomedioultimacompra] > 0, fat_compraproduto[vl_percmediovariacaoultimacompra] > 0.15, fat_compraproduto[vl_percvariacaoultimacompra] > 0.15)) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: c8966e83-bb58-4851-8de1-3b824c9b1c3e

	/// Quantidade de ordens de compra distintas (nr_identificadorordemcompra) pendentes de aprovação com mais de 48 horas: fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovação em andamento", nr_identificadorordemcompra não em branco/nulo, prazo contado a partir de dt_emissaoordemcompra + hr_emissaoordemcompra, mais de 48h em relação a NOW(). O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Ordens Compra Pendentes de Aprovação (Atraso 48h)' =
			VAR LimiteAtraso = NOW() - 2
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(fat_compraproduto[nr_identificadorordemcompra]),
			    FILTER(
			        fat_compraproduto,
			        fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovação em andamento"
			            && NOT ISBLANK(fat_compraproduto[nr_identificadorordemcompra])
			            && NOT ISBLANK(fat_compraproduto[dt_emissaoordemcompra])
			            && NOT ISBLANK(fat_compraproduto[hr_emissaoordemcompra])
			            && fat_compraproduto[dt_emissaoordemcompra] + TIMEVALUE(fat_compraproduto[hr_emissaoordemcompra]) <= LimiteAtraso
			    )
			) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: aa471a04-fb7f-4b70-936f-e710516088c5

	/// Data e hora de emissão da ordem de compra em um único valor (dt_emissaoordemcompra + hr_emissaoordemcompra), para exibir como coluna única "Emissão Ordem" na tabela da página Ordem Compra, substituindo as colunas separadas de data e horário.
	measure 'Data e Horário Emissão Ordem Compra' =
			VAR DataEmissao = SELECTEDVALUE ( fat_compraproduto[dt_emissaoordemcompra] )
			VAR HoraEmissao = SELECTEDVALUE ( fat_compraproduto[hr_emissaoordemcompra] )
			RETURN
			    IF (
			        NOT ISBLANK ( DataEmissao ) && NOT ISBLANK ( HoraEmissao ),
			        DataEmissao + TIMEVALUE ( HoraEmissao )
			    )
		formatString: dd/mm/yyyy hh:mm
		displayFolder: Data
		lineageTag: aed23ec4-2655-4212-8b29-cc2f36653659

	/// Prazo decorrido, em horas, desde a emissão da ordem de compra (dt_emissaoordemcompra + hr_emissaoordemcompra) até o momento atual (NOW()). Usar como coluna "Prazo" na tabela da página Ordem Compra (renomear título do campo no visual).
	measure 'Prazo Ordem Compra (Horas)' =
			VAR DataEmissao = SELECTEDVALUE ( fat_compraproduto[dt_emissaoordemcompra] )
			VAR HoraEmissao = SELECTEDVALUE ( fat_compraproduto[hr_emissaoordemcompra] )
			VAR Emissao = DataEmissao + TIMEVALUE ( HoraEmissao )
			RETURN
			    IF (
			        NOT ISBLANK ( Emissao ),
			        ROUND ( ( NOW () - Emissao ) * 24, 1 )
			    )
		formatString: 0.0 "h"
		displayFolder: KPIs
		lineageTag: 05d1bfea-91aa-4b28-836c-0040b4b4782a

	/// Retorna a menor data prevista de entrega (dt_previstaentregaordemcompra) considerando valores distintos de nr_identificadorordemcompra na tabela fat_compraproduto.
	measure 'Maior Data Entrega Ordem Compra' = MINX(DISTINCT(fat_compraproduto[nr_identificadorordemcompra]), CALCULATE(MIN(fat_compraproduto[dt_previstaentregaordemcompra])))
		formatString: dd/mm/yyyy
		displayFolder: Data
		lineageTag: 640337ef-2b9c-4374-9755-0fc96808cc42

	/// Medida de suporte para formatação condicional da coluna 'Data Entrega' na tabela da página 'Recebimento'. Retorna vermelho (#FF0000) quando a maior data de entrega for maior que hoje, e verde (#008000) caso contrário.
	measure 'Cor Fonte Data Entrega' = IF([Maior Data Entrega Ordem Compra] >= TODAY(), "#008000", "#FF0000")
		isHidden
		displayFolder: Suporte
		lineageTag: 41c90cf1-2e3b-4905-bd95-ce78e47b22fb

	/// Total de ordens de compra distintas (nr_identificadorordemcompra) com status de recebimento 'Pendente recebimento' ou 'Parcialmente recebido', desconsiderando valores em branco/nulo de nr_identificadorordemcompra. Retorna 0 quando o resultado for branco/nulo (+0).
	measure 'Qtd Ordens Compra Pendente Recebimento' = CALCULATE(DISTINCTCOUNT(fat_compraproduto[nr_identificadorordemcompra]), fat_compraproduto[ds_statusrecebimento] IN { "Pendente recebimento", "Parcialmente recebido" }, NOT ISBLANK(fat_compraproduto[nr_identificadorordemcompra])) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 231e6cbf-b331-49fa-936f-9b77dd0fbe7c

	/// Total de produtos (linhas) de ordens de compra com status de recebimento 'Pendente recebimento' ou 'Parcialmente recebido', desconsiderando valores em branco/nulo de nr_identificadorordemcompra na tabela fat_compraproduto. Retorna 0 quando o resultado for branco/nulo (+0).
	measure 'Qtd Produtos de Ordem Compra Pendente Recebimento' = CALCULATE(COUNTROWS(fat_compraproduto), fat_compraproduto[ds_statusrecebimento] IN { "Pendente recebimento", "Parcialmente recebido" }, NOT ISBLANK(fat_compraproduto[nr_identificadorordemcompra])) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: cad034c0-dbbf-4085-b884-14a1d61eff89

	/// Total de produtos (linhas) de ordens de compra pendentes de recebimento em atraso: status de recebimento 'Pendente recebimento' ou 'Parcialmente recebido', nr_identificadorordemcompra não branco/nulo e dt_previstaentregaordemcompra maior que a data atual. Retorna 0 quando o resultado for branco/nulo (+0).
	measure 'Qtd Produtos Ordem Compra Pendente Recebimento (Atraso Entrega)' = CALCULATE(COUNTROWS(fat_compraproduto), fat_compraproduto[ds_statusrecebimento] IN { "Pendente recebimento", "Parcialmente recebido" }, NOT ISBLANK(fat_compraproduto[nr_identificadorordemcompra]), fat_compraproduto[dt_previstaentregaordemcompra] < TODAY()) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 2940df75-4474-4faa-b020-0e7f23587121

	/// Total de ordens de compra distintas (nr_identificadorordemcompra) com status de recebimento 'Pendente recebimento' ou 'Parcialmente recebido', nr_identificadorordemcompra não branco/nulo, e cuja emissão (dt_emissaoordemcompra + hr_emissaoordemcompra) ultrapassou 72 horas em relação a NOW(). Retorna 0 quando o resultado for branco/nulo (+0).
	measure 'Qtd Ordens Compra Pendentes de Recebimento (Atraso 72h)' = VAR _LimiteAtraso = NOW() - 3 RETURN CALCULATE(DISTINCTCOUNT(fat_compraproduto[nr_identificadorordemcompra]), fat_compraproduto[ds_statusrecebimento] IN { "Pendente recebimento", "Parcialmente recebido" }, NOT ISBLANK(fat_compraproduto[nr_identificadorordemcompra]), FILTER(fat_compraproduto, fat_compraproduto[dt_emissaoordemcompra] + TIMEVALUE(fat_compraproduto[hr_emissaoordemcompra]) <= _LimiteAtraso)) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: f75b62e0-64e0-43f3-922d-4a22aceecf09

	/// Soma de vl_totalnegociado em fat_compraproduto, considerando apenas registros com nr_identificadorordemcompra preenchido (não branco/nulo) e ds_statusaprovacaoordemcompra igual a "Aprovado".
	measure 'Valor Total Negociado (Aprovado)' =
			CALCULATE(
			    SUM(fat_compraproduto[vl_totalnegociado]),
			    NOT ISBLANK(fat_compraproduto[nr_identificadorordemcompra]),
			    fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovado"
			)
		formatString: R$ #,##0
		displayFolder: Negociação
		lineageTag: 43a97316-6b82-4d20-83fa-789af17d42bf

	/// Soma de vl_totaldescontonegociado em fat_compraproduto, considerando apenas registros com nr_identificadorordemcompra preenchido (não branco/nulo) e ds_statusaprovacaoordemcompra igual a "Aprovado".
	measure 'Valor Total Desconto Negociado (Aprovado)' =
			CALCULATE(
			    SUM(fat_compraproduto[vl_totaldescontonegociado]),
			    NOT ISBLANK(fat_compraproduto[nr_identificadorordemcompra]),
			    fat_compraproduto[ds_statusaprovacaoordemcompra] = "Aprovado"
			)
		formatString: R$ #,##0
		displayFolder: Negociação
		lineageTag: ca19a997-d26e-4012-84c0-bb991b8ca79f

	/// Percentual que o Valor Total Negociado (Aprovado) da filial representa sobre o total geral (todas as filiais no contexto selecionado).
	measure '% Valor Negociado sobre Total (Filial)' =
			DIVIDE(
			    [Valor Total Negociado (Aprovado)],
			    CALCULATE([Valor Total Negociado (Aprovado)], ALLSELECTED(dim_filial[nm_nomeabreviado]))
			)
		formatString: 0.0%
		displayFolder: Negociação
		lineageTag: a1bec3d2-31f3-413b-af06-73efa2acc9a5

	/// Percentual que o Valor Total Desconto Negociado (Aprovado) da filial representa sobre o total geral (todas as filiais no contexto selecionado).
	measure '% Valor Desconto Negociado sobre Total (Filial)' =
			DIVIDE(
			    [Valor Total Desconto Negociado (Aprovado)],
			    CALCULATE([Valor Total Desconto Negociado (Aprovado)], ALLSELECTED(dim_filial[nm_nomeabreviado]))
			)
		formatString: 0.0%
		displayFolder: Negociação
		lineageTag: c06cdd19-b84b-4a35-949e-377deb152e94

	/// Quantidade de produtos de solicitações de compra pendentes de aprovação (ds_statussolicitacaofluig = "Pendente") que são de ressuprimento (ds_ressuprimento = "Sim"). O "+ 0" garante retorno 0 em vez de BLANK quando não houver registros no contexto de filtro atual.
	measure 'Qtd Produtos Ressuprimento de Solicitação Pendentes de Aprovação' =
			CALCULATE (
			    COUNTROWS ( fat_compraproduto ),
			    fat_compraproduto[ds_statussolicitacaofluig] = "Pendente",
			    fat_compraproduto[ds_ressuprimento] = "Sim"
			) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: a2794c8b-6e38-4394-81c0-8c1028da5c8c

	/// Retorna 1 quando o mês de referência (ds_referencia_ano_mes) está dentro dos últimos 12 meses, incluindo o mês atual.
	measure 'Indicador Últimos 12 Meses' =
			VAR _Hoje = TODAY()
			VAR _Inicio = FORMAT(EDATE(_Hoje, -11), "yyyy-MM")
			VAR _Fim = FORMAT(_Hoje, "yyyy-MM")
			VAR _Mes = SELECTEDVALUE(dim_tempoperiodo[ds_referencia_ano_mes])
			RETURN
			IF(NOT ISBLANK(_Mes) && _Mes >= _Inicio && _Mes <= _Fim, 1, 0)
		formatString: 0
		displayFolder: Data
		lineageTag: 28327b59-0d5e-411b-a3a8-f2f6664f0cb9

	/// Quantidade de cotações distintas (nr_cotacao) já enviadas ao fornecedor: nr_cotacao não em branco e ds_statuscotacao diferente de "Composição" (cotações ainda em composição não foram enviadas). Usada no gráfico de popularidade de cotações por fornecedor da página Performance.
	measure 'Qtd Cotações Enviadas ao Fornecedor' =
			CALCULATE(
			    DISTINCTCOUNT(fat_compraproduto[nr_cotacao]),
			    NOT ISBLANK(fat_compraproduto[nr_cotacao]),
			    fat_compraproduto[ds_statuscotacao] <> "Composição"
			)
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: b7ea0124-d5a2-435c-8530-33b5f7acebef

	column _Blank
		lineageTag: 2acaf452-428f-42a9-a23f-1b260f68c27e
		isNameInferred
		sourceColumn: [_Blank]

	partition _Medidas = calculated
		mode: import
		source = ROW("_Blank", BLANK())

