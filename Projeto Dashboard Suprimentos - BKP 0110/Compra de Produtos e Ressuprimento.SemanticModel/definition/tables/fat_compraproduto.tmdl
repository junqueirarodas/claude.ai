		annotation SummarizationSetBy = Automatic

	/// Coluna calculada (não medida) para permitir uso em slicer: retorna "Em Atraso" quando a abertura da solicitação (dt_aberturasolicitacaofluig + hr_aberturasolicitacaofluig) ultrapassou 24 horas em relação ao momento do último cálculo/atualização do modelo (NOW()), e "No Prazo" caso contrário (inclusive quando em branco). Diferente da medida equivalente, o valor é fixado no momento da atualização dos dados, não recalculado em tempo real.
	column 'Indicador Prazo Aprovação' =
			VAR Abertura = fat_compraproduto[dt_aberturasolicitacaofluig] + TIMEVALUE ( fat_compraproduto[hr_aberturasolicitacaofluig] )
			VAR LimiteAtraso = NOW () - 1
			RETURN
			    IF (
			        NOT ISBLANK ( Abertura ) && Abertura <= LimiteAtraso,
			        "Em Atraso",
			        "No Prazo"
			    )
		dataType: string
		displayFolder: Suporte
		lineageTag: b4f17fda-c16f-402b-a1aa-5b17c3db599b

	/// Coluna calculada (não medida) para permitir uso em slicer: retorna "Em Atraso" quando a aprovação da solicitação (dt_aprovacaosolicitacao + hr_aprovacaosolicitacao) ultrapassou 24 horas em relação ao momento do último cálculo/atualização do modelo (NOW()), e "No Prazo" caso contrário (inclusive quando em branco). Equivalente à medida 'Indicador Prazo Envio Cotação'.
	column 'Indicador Prazo Envio Cotação' =
			VAR Aprovacao = fat_compraproduto[dt_aprovacaosolicitacao] + TIMEVALUE ( fat_compraproduto[hr_aprovacaosolicitacao] )
			VAR LimiteAtraso = NOW () - 1
			RETURN
			    IF (
			        NOT ISBLANK ( Aprovacao ) && Aprovacao <= LimiteAtraso,
			        "Em Atraso",
			        "No Prazo"
			    )
		dataType: string
		displayFolder: Suporte
		lineageTag: 719d5dad-d8c5-4494-815d-331cfebec07f

	/// Coluna calculada (não medida) para permitir uso em slicer: retorna "Em Atraso" quando a emissão da cotação (dt_emissaocotacao + hr_emissaocotacao) ultrapassou 24 horas em relação ao momento do último cálculo/atualização do modelo (NOW()), e "No Prazo" caso contrário (inclusive quando em branco). Equivalente à medida 'Indicador Prazo Negociação'.
	column 'Indicador Prazo Negociação' =
			VAR Emissao = fat_compraproduto[dt_emissaocotacao] + TIMEVALUE ( fat_compraproduto[hr_emissaocotacao] )
			VAR LimiteAtraso = NOW () - 2
			RETURN
			    IF (
			        NOT ISBLANK ( Emissao ) && Emissao <= LimiteAtraso,
			        "Em Atraso",
			        "No Prazo"
			    )
		dataType: string
		displayFolder: Suporte
		lineageTag: 60579cdb-f07a-4c45-948f-d6b0b6d46ef4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Coluna calculada (não medida) para permitir uso em slicer: retorna "Em Atraso" quando a emissão da ordem de compra (dt_emissaoordemcompra + hr_emissaoordemcompra) ultrapassou 48 horas em relação ao momento do último cálculo/atualização do modelo (NOW()), e "No Prazo" caso contrário (inclusive quando em branco).
	column 'Indicador Prazo Ordem Compra' =
			VAR Emissao = fat_compraproduto[dt_emissaoordemcompra] + TIMEVALUE ( fat_compraproduto[hr_emissaoordemcompra] )
			VAR LimiteAtraso = NOW () - 2
			RETURN
			    IF (
			        NOT ISBLANK ( Emissao ) && Emissao <= LimiteAtraso,
			        "Em Atraso",
			        "No Prazo"
			    )
		dataType: string
		displayFolder: Suporte
		lineageTag: 56182da2-a4d4-4b1f-8b7f-829e6b75f21a

