table _Medidas
	lineageTag: a771b61c-f0e2-48e6-a675-05753ae93841

	/// Lead time médio (dias) entre abertura e aprovação da solicitação de compra = soma dos valores preenchidos dividida pela quantidade de valores preenchidos. SUM() e COUNT() ignoram NULL/BLANK nativamente, logo linhas sem essa etapa não entram no cálculo.
	measure 'Abertura até Aprovação' =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaberturasolicitacaoaprovacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaberturasolicitacaoaprovacao] )
			)
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: 965adb54-f5e7-41d8-aa8e-4a3c730b9c11

	/// Lead time médio (dias) entre aprovação da solicitação e emissão da cotação = soma dos valores preenchidos dividida pela quantidade de valores preenchidos. SUM() e COUNT() ignoram NULL/BLANK nativamente, logo linhas sem essa etapa não entram no cálculo.
	measure 'Aprovação até Cotação' =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaprovacaosolicitacaocotacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaprovacaosolicitacaocotacao] )
			)
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: 8d5cdf97-e646-4d0a-871a-e586466c0898

	/// Lead time médio (dias) entre a cotação e a emissão da ordem de compra = soma dos valores preenchidos dividida pela quantidade de valores preenchidos. SUM() e COUNT() ignoram NULL/BLANK nativamente, logo linhas sem essa etapa não entram no cálculo.
	measure 'Cotação até Ordem Compra' =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimecotacaocompra] ),
			    COUNT ( fat_compraproduto[vl_leadtimecotacaocompra] )
			)
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: ef4593a3-61a4-4fc8-b718-84b78e19cd36

	/// Lead time médio (dias) entre a emissão e a aprovação da ordem de compra = soma dos valores preenchidos dividida pela quantidade de valores preenchidos. SUM() e COUNT() ignoram NULL/BLANK nativamente, logo linhas sem essa etapa não entram no cálculo.
	measure 'Ordem Compra até Aprovação' =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimecompraaprovacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimecompraaprovacao] )
			)
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: 8f517119-a8d5-4888-b29c-0c83044d021a

	/// Lead time médio (dias) entre a aprovação da ordem de compra e o recebimento = soma dos valores preenchidos dividida pela quantidade de valores preenchidos. SUM() e COUNT() ignoram NULL/BLANK nativamente, logo linhas sem essa etapa não entram no cálculo.
	measure 'Aprovação até Recebimento' =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaprovacaorecebimento] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaprovacaorecebimento] )
			)
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: c011b4ac-3c44-45da-a412-9d5151b56ce4

	/// Lead time médio geral (dias) = soma de todos os valores preenchidos nos 5 lead times de etapa, dividida pela quantidade de valores preenchidos (não pela quantidade de linhas). SUM() e COUNT() ignoram nativamente NULL/BLANK, logo etapas não preenchidas não entram nem no numerador nem no denominador do cálculo.
	measure 'Lead Time Geral' = ```
			VAR LTSolicitacaoAprovacao =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaberturasolicitacaoaprovacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaberturasolicitacaoaprovacao] )
			)
			VAR LTAprovacaoSolicitacaoCotacao =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaprovacaosolicitacaocotacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaprovacaosolicitacaocotacao] )
			) 
			VAR LTCotacaoCompra =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimecotacaocompra] ),
			    COUNT ( fat_compraproduto[vl_leadtimecotacaocompra] )
			)
			VAR LTCompraAprovacaoOrdem =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimecompraaprovacao] ),
			    COUNT ( fat_compraproduto[vl_leadtimecompraaprovacao] )
			)
			VAR LTAprovacaoOrdemRecebimento =
			DIVIDE (
			    SUM ( fat_compraproduto[vl_leadtimeaprovacaorecebimento] ),
			    COUNT ( fat_compraproduto[vl_leadtimeaprovacaorecebimento] )
			)
			VAR LTGeral = ( LTSolicitacaoAprovacao + LTAprovacaoSolicitacaoCotacao + LTCotacaoCompra + LTCompraAprovacaoOrdem + LTAprovacaoOrdemRecebimento )
			RETURN LTGeral
			```
		formatString: #,##0.0
		displayFolder: Lead Time
		lineageTag: f18b96f2-05b8-4ba5-a4b8-adc84fe6ff49

	/// Medida de suporte: quantidade de linhas de fat_compraproduto no contexto de filtro atual. Usada para restringir slicers (ex.: Safra) a exibir apenas valores de dimensão que possuem correspondência real via relacionamento sk_safra, evitando itens sem dados.
	measure 'Qtd Registros (Fato)' = COUNTROWS ( fat_compraproduto )
		formatString: 0
		isHidden
		displayFolder: Suporte
		lineageTag: 0516aed6-7016-41c7-97f6-b9ad35790476

	/// Medida de suporte: posição (ranking) do fornecedor pelo lead time médio de Aprovação até Recebimento (atraso na entrega da mercadoria), do maior para o menor. Usada para filtrar o gráfico 'TOP Fornecedores (atraso entrega da mercadoria)' aos 20 fornecedores com maior lead time.
	measure 'Rank Fornecedor (Atraso Entrega)' = RANKX ( ALLSELECTED ( dim_fornecedor[ds_fornecedor] ), [Aprovação até Recebimento], , DESC, DENSE )
		formatString: 0
		isHidden
		displayFolder: Suporte
		lineageTag: f89e4962-51c7-463d-b1ec-a33303b852e2

	/// Quantidade total de solicitações de compra pendentes de aprovação, com base em fat_compraproduto[ds_statussolicitacaofluig] = "Pendente". O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Solicitações Pendentes de Aprovação (Produtos)' =
			CALCULATE (
			    COUNTROWS ( fat_compraproduto ),
			    fat_compraproduto[ds_statussolicitacaofluig] = "Pendente"
			) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: ebf6cdcf-8a3a-4247-a3f2-458ce2e55af7

	/// Quantidade de solicitações de compra distintas pendentes de aprovação, contando cada solicitação (nr_processosolicitacaofluig) uma única vez mesmo quando possui vários itens/produtos (linhas) em fat_compraproduto. Base: fat_compraproduto[ds_statussolicitacaofluig] = "Pendente". O "+ 0" garante retorno 0 (em vez de BLANK) quando não houver registros no contexto de filtro atual.
	measure 'Qtd Solicitações Pendentes de Aprovação (NR Solicitação)' =
			CALCULATE (
			    DISTINCTCOUNT ( fat_compraproduto[nr_processosolicitacaofluig] ),
			    fat_compraproduto[ds_statussolicitacaofluig] = "Pendente"
			) + 0
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: bc15f89c-331f-447b-8516-eb200813c39d

	column _Blank
		lineageTag: 2acaf452-428f-42a9-a23f-1b260f68c27e
		isNameInferred
		sourceColumn: [_Blank]

	partition _Medidas = calculated
		mode: import
		source = ROW("_Blank", BLANK())

